import pandas as pd
import numpy as np
import tensorflow_hub as hub
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder
from sklearn.metrics import classification_report, accuracy_score
from imblearn.over_sampling import SMOTE
from sklearn.ensemble import RandomForestClassifier
import xgboost as xgb

# 1. Load data dan merge
questions = pd.read_csv('questions.csv')
majors = pd.read_csv('majors.csv')
qmw = pd.read_csv('qmw.csv')

df = pd.merge(questions, qmw, on='question_id', how='left')
df = pd.merge(df, majors, on='major_id', how='left')
df = df.dropna(subset=['question_text', 'major_id'])

# 2. Penggabungan kelas kasar berdasarkan 2 karakter pertama (ubah sesuai domain)
def map_major_coarse(major_id):
    prefix = major_id[:2]
    if prefix in ['AB', 'AC', 'AD']:
        return 'Group1'
    elif prefix in ['AE', 'AF', 'AG']:
        return 'Group2'
    elif prefix in ['AI', 'AJ', 'AK']:
        return 'Group3'
    else:
        return 'Other'

df['major_group_coarse'] = df['major_id'].apply(map_major_coarse)

# 3. Encode label
le = LabelEncoder()
df['label'] = le.fit_transform(df['major_group_coarse'])

# 4. Load Universal Sentence Encoder
print("Loading Universal Sentence Encoder...")
embed = hub.load("https://tfhub.dev/google/universal-sentence-encoder/4")

# 5. Encode teks
print("Encoding texts...")
X_embed = embed(df['question_text'].tolist()).numpy()
y = df['label'].values

# 6. Split data stratified
X_train, X_test, y_train, y_test = train_test_split(
    X_embed, y, test_size=0.2, random_state=42, stratify=y)

print("Distribusi kelas train sebelum SMOTE:")
print(pd.Series(y_train).value_counts())

# 7. Terapkan SMOTE pada data train
smote = SMOTE(random_state=42)
X_train_res, y_train_res = smote.fit_resample(X_train, y_train)

print("\nDistribusi kelas train setelah SMOTE:")
print(pd.Series(y_train_res).value_counts())

# 8. Training Random Forest
rf_clf = RandomForestClassifier(n_estimators=100, random_state=42)
rf_clf.fit(X_train_res, y_train_res)
y_pred_rf = rf_clf.predict(X_test)
print("\n=== Random Forest Classification Report ===")
print(classification_report(y_test, y_pred_rf, zero_division=1, target_names=le.classes_))

accuracy_rf = accuracy_score(y_test, y_pred_rf)
print(f"Random Forest Accuracy: {accuracy_rf:.4f}")

# 9. Training XGBoost
xgb_clf = xgb.XGBClassifier(eval_metric='mlogloss', random_state=42)
xgb_clf.fit(X_train_res, y_train_res)
y_pred_xgb = xgb_clf.predict(X_test)
print("\n=== XGBoost Classification Report ===")
print(classification_report(y_test, y_pred_xgb, zero_division=1, target_names=le.classes_))

accuracy_xgb = accuracy_score(y_test, y_pred_xgb)
print(f"XGBoost Accuracy: {accuracy_xgb:.4f}")
